# Copia questo file in `.env.local` e compila i valori.
# `.env.local` è ignorato da git: i valori veri non vanno mai nel repo.
# Le variabili con prefisso VITE_ finiscono nel bundle del browser: solo valori pubblici.

# Supabase per l'app. In locale li stampa `npx supabase status` (API_URL e PUBLISHABLE_KEY).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Widget Cloudflare Turnstile (CAPTCHA di accesso e registrazione). In locale la chiave di prova
# pubblica di Cloudflare, che passa sempre: 1x00000000000000000000AA. In produzione è in netlify.toml.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Solo per l'Image Sync (npm run sync:images), MAI nel frontend: la chiave segreta bypassa la RLS.
# In locale li stampa `npx supabase status` (API_URL e SECRET_KEY).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Connessione Postgres usata dal Catalog Sync e dai test del database.
# Se vuota si usa il Supabase locale: postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_DB_URL=

# Segnalazione degli errori a Sentry (RIB-35). Vuoto = Sentry spento (di solito in locale).
# In produzione sta nelle variabili di Netlify, con SENTRY_ORG, SENTRY_PROJECT e il segreto
# SENTRY_AUTH_TOKEN per caricare le source map (docs/sentry.md).
VITE_SENTRY_DSN=
